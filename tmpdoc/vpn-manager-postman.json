							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"profile_id\": \"{{profile_id}}\",\n  \"provider_id\": \"{{provider_id}}\",\n  \"rule_type\": \"domain\",\n  \"value\": \"youtube.com\",\n  \"enabled\": true,\n  \"priority\": 100,\n  \"description\": \"YouTube через VPN\"\n}"
